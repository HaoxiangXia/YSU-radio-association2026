<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>无线电爱好者协会 | 燕山大学</title>
  <link rel="icon" href="/favicon.ico">
  <link rel="stylesheet" href="/html/styles.css?v=20260911">
  <link rel="stylesheet" href="/html/site-intro.css">
  <style is:global>
.home-page {
  --home-electric-blue: #2563eb;
  --home-cyan: #0891b2;
  --home-panel-light: #dceafb;
  background: #f5f8fc;
  height: 100vh;
  height: 100dvh;
  overflow: hidden;
  overscroll-behavior: none;
}

.home-page .nav {
  position: fixed;
  inset: 0 0 auto 0;
}

.home-page .hero {
  position: relative;
  height: 100%;
  min-height: 0;
  overflow: hidden;
  isolation: isolate;
  background: linear-gradient(125deg, #eef7ff 0%, #e4f1fc 48%, #d8eaf8 100%);
}

.home-page .hero-bg {
  position: absolute;
  inset: 0;
  z-index: -1;
}

.home-page .home-hero-canvas {
  position: absolute;
  inset: 0;
  z-index: 2;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.home-page .home-hero-mesh {
  position: absolute;
  inset: 0;
  z-index: 1;
  opacity: 0.42;
  background-image:
    linear-gradient(rgba(30, 78, 121, 0.13) 1px, transparent 1px),
    linear-gradient(90deg, rgba(30, 78, 121, 0.13) 1px, transparent 1px);
  background-position: center;
  background-size: 52px 52px;
  -webkit-mask-image: linear-gradient(90deg, transparent 4%, rgba(0, 0, 0, 0.22) 34%, #000 58%, #000);
  mask-image: linear-gradient(90deg, transparent 4%, rgba(0, 0, 0, 0.22) 34%, #000 58%, #000);
  pointer-events: none;
}

.home-page .hero-content {
  position: relative;
  z-index: 6;
  display: flex;
  height: 100%;
  min-height: 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: calc(var(--nav-height) + 1.25rem);
  padding-bottom: 0;
  text-align: center;
}

.home-page .home-hero-copy {
  position: relative;
  width: min(100%, 900px);
  max-width: 900px;
  text-align: center;
}

.home-page .hero-content h1 {
  max-width: 900px;
  margin-bottom: 1.25rem;
  color: #10233f;
  font-size: clamp(3rem, 5.9vw, 5.35rem);
  font-weight: 720;
  line-height: 1.05;
  letter-spacing: -0.025em;
  text-wrap: balance;
}

.home-page .hero-content p {
  max-width: 42rem;
  margin: 0 auto 2rem;
  color: #52657d;
  font-size: clamp(1.05rem, 1.5vw, 1.24rem);
  letter-spacing: 0.03em;
}

/* 电脑端标题保持单行：clamp 按视口缩放，nowrap 不会溢出（最宽约需 69% 视口宽） */
@media (min-width: 801px) {
  .home-page .hero-content h1 {
    max-width: none;
    white-space: nowrap;
    text-wrap: nowrap;
  }
}

.home-page .hero-buttons {
  display: flex;
  justify-content: center;
  gap: 0.85rem;
}

.home-page .btn-primary {
  display: inline-flex;
  min-height: 2.75rem;
  align-items: center;
  justify-content: center;
  gap: 0.4rem;
  padding: 0.6rem 1.5rem;
  border: 1px solid rgba(255,255,255,0.5);
  border-radius: var(--radius);
  color: #fff;
  font-size: 0.95rem;
  font-weight: 500;
  text-decoration: none;
  transition:
    transform 220ms ease,
    border-color 220ms ease,
    box-shadow 220ms ease,
    background-color 220ms ease,
    color 220ms ease;
}

.home-page .hero-btn-primary,
.home-page .hero-btn-secondary {
  position: relative;
  min-width: 8rem;
  overflow: hidden;
}

.home-page .hero .hero-btn-primary {
  color: #ffffff;
  border-color: #2563eb;
  background: #2563eb;
  box-shadow: 0 10px 26px rgba(37, 99, 235, 0.2);
}

.home-page .hero .hero-btn-secondary {
  color: #1e4f91;
  border-color: rgba(30, 79, 145, 0.32);
  background: #ffffff;
}

.home-page .footer,
.home-page .scrollTopBtn {
  display: none;
}

@media (hover: hover) {
  .home-page .hero .hero-btn-primary:hover {
    transform: translateY(-2px);
    border-color: #1d4ed8;
    background: #1d4ed8;
    box-shadow: 0 14px 30px rgba(37, 99, 235, 0.26);
  }

  .home-page .hero .hero-btn-secondary:hover {
    transform: translateY(-2px);
    color: #173f73;
    border-color: rgba(30, 79, 145, 0.5);
    background: rgba(255, 255, 255, 0.88);
    box-shadow: 0 12px 26px rgba(41, 76, 112, 0.13);
  }
}

@media (max-width: 800px) {
  .home-page .home-hero-mesh {
    opacity: 0.3;
    background-size: 44px 44px;
    -webkit-mask-image: none;
    mask-image: none;
  }

  .home-page .hero-content h1 {
    max-width: 37rem;
    font-size: clamp(2.55rem, 8vw, 3.45rem);
  }
}

@media (max-width: 540px) {
  .home-page .hero-content {
    padding-right: 1rem;
    padding-left: 1rem;
  }

  .home-page .hero-content h1 {
    font-size: clamp(2.25rem, 10.5vw, 2.75rem);
    line-height: 1.08;
  }

  .home-page .hero-content p {
    max-width: 21rem;
    margin-bottom: 1.6rem;
    font-size: 0.98rem;
    line-height: 1.65;
  }

  .home-page .hero-buttons {
    gap: 0.65rem;
  }

  .home-page .hero-btn-primary,
  .home-page .hero-btn-secondary {
    min-width: 7rem;
    min-height: 2.75rem;
    padding-right: 1.1rem;
    padding-left: 1.1rem;
  }
}

@media (max-height: 720px), (min-width: 801px) and (max-height: 850px) {
  .home-page .hero-content {
    justify-content: center;
    padding-top: calc(2 * (var(--nav-height) + 0.75rem));
    padding-bottom: calc(var(--nav-height) + 0.75rem);
  }

  .home-page .hero-content h1 {
    margin-bottom: 0.85rem;
    font-size: clamp(2.2rem, 5vw, 3.8rem);
  }

  .home-page .hero-content p {
    margin-bottom: 1.25rem;
  }
}

/* 极矮视口（≤720px）内容已溢出 hero，仅保留最小间距避免进一步下推裁切 */
@media (max-height: 720px) {
  .home-page .hero-content {
    padding-top: calc(var(--nav-height) + 0.25rem);
  }
}

/* 卡片用到的、styles.css 缺失的工具类（原样取自 about-association-landing.css） */
.bg-gray-100 { background-color: rgb(243, 244, 246); }
.justify-center { justify-content: center; }
.overflow-hidden { overflow: hidden; }
.h-full { height: 100%; }
.object-cover { object-fit: cover; }
.aspect-video { aspect-ratio: 16 / 9; }

/* Hero 内的协会简介卡片 */
.home-page .card.about-assoc-intro {
  width: 100%;
  margin: 0 auto 1.5rem;
  text-align: left;
  display: grid;
  grid-template-columns: 1.18fr 1fr;
  grid-template-areas:
    "media body"
    "media stats";
  gap: 0.85rem 1.6rem;
  align-items: center;
  padding: clamp(1rem, 1.6vw, 1.35rem);
  border-color: rgba(111, 142, 196, 0.16);
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.96), rgba(247, 250, 255, 0.92));
  box-shadow: rgba(33, 55, 92, 0.07) 0px 20px 50px, rgba(255, 255, 255, 0.82) 0px 1px 0px inset;
}
.home-page .about-assoc-intro__media { grid-area: media; min-width: 0; }
.home-page .about-assoc-intro__body { grid-area: body; min-width: 0; display: flex; flex-direction: column; justify-content: flex-end; }
.home-page .about-assoc-intro__stats { grid-area: stats; min-width: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.6rem; }
.home-page .about-assoc-intro__body p { font-size: clamp(0.96rem, 1.25vw, 1.08rem); line-height: 1.75; color: rgb(71, 85, 105); margin: 0; }
.home-page .about-assoc-intro__body p .font-semibold, .home-page .about-assoc-intro__body p .font-medium { color: rgb(30, 41, 59); }
.home-page .about-assoc-intro__media .aspect-video { aspect-ratio: 16 / 9; border-radius: var(--radius); background: rgb(241, 245, 249); overflow: hidden; }

/* 与 .site-page 变体对齐的统计卡样式（styles.css），首页不是 .site-page，需补 */
.home-page .about-assoc-intro__stats .stat-card { border-color: rgba(96, 165, 250, 0.18); background: #ffffff; box-shadow: 0 10px 28px rgba(15, 23, 42, 0.055); }
.home-page .about-assoc-intro__stats .stat-value { color: #1d4ed8; font-weight: 750; }
.home-page .about-assoc-intro__stats .stat-label { color: #5c6b83; }

/* 低高度电脑端视口：压缩卡片与边距 */
@media (min-width: 801px) and (max-height: 800px) {
  .home-page .card.about-assoc-intro { gap: 0.65rem 1.2rem; margin-bottom: 0.85rem; padding: 0.9rem 1.15rem; }
  .home-page .hero-content { justify-content: center; }
}
/* 移动端 方案 A：极致工程无框流，彻底解构嵌套卡片 */
@media (max-width: 800px) {
  .home-page .hero-content { justify-content: flex-start; padding-top: calc(var(--nav-height) + 1.25rem); padding-bottom: 0.85rem; overflow-y: auto; }
  .home-page .hero-title__school,
  .home-page .hero-title__dept {
    display: block;
  }
  .home-page .hero-title__dept {
    white-space: nowrap;
  }
  .home-page .hero-content h1 {
    margin-bottom: 0.35rem;
    font-size: clamp(1.8rem, 7.2vw, 2.5rem);
    line-height: 1.15;
  }
  .home-page .hero-content p { margin-bottom: 0.65rem; font-size: 0.95rem; }
  .home-page .card.about-assoc-intro {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin-bottom: 0.85rem;
    padding: 0 0 0.85rem 0;
    overflow: hidden;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.36) 0%, rgba(255, 255, 255, 0.15) 100%);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.68);
    border-radius: 16px;
    box-shadow: 0 10px 32px rgba(26, 68, 114, 0.06), inset 0 1px 1px rgba(255, 255, 255, 0.82);
  }
  .home-page .about-assoc-intro__media {
    width: 100%;
    margin: 0;
  }
  .home-page .about-assoc-intro__media .aspect-video {
    aspect-ratio: 16 / 9;
    height: auto;
    border-radius: 0;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.45);
    box-shadow: none;
    background: transparent;
  }
  /* 扁平仪器数据带（Telemetry Strip），消除 4 个独立卡片容器与阴影 */
  .home-page .about-assoc-intro__stats {
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    margin: 0.15rem 0.85rem 0;
    padding: 0.45rem 0;
    background: transparent;
    border-top: 1px solid rgba(148, 163, 184, 0.22);
    border-bottom: 1px solid rgba(148, 163, 184, 0.22);
  }
  .home-page .about-assoc-intro__stats .stat-card {
    background: transparent;
    border: none;
    box-shadow: none;
    border-radius: 0;
    padding: 0.2rem 0.15rem;
    text-align: center;
    position: relative;
  }
  .home-page .about-assoc-intro__stats .stat-card:not(:last-child)::after {
    content: "";
    position: absolute;
    right: 0;
    top: 18%;
    height: 64%;
    width: 1px;
    background: rgba(148, 163, 184, 0.22);
  }
  .home-page .about-assoc-intro__stats .stat-value {
    color: #1d4ed8;
    font-size: clamp(1.02rem, 4.4vw, 1.15rem);
    font-weight: 750;
    line-height: 1.15;
  }
  .home-page .about-assoc-intro__stats .stat-label {
    color: #64748b;
    font-size: clamp(0.64rem, 2.6vw, 0.72rem);
    margin-top: 0.2rem;
    line-height: 1.15;
  }
  /* 只留“走过春秋”一句，去框平铺 */
  .home-page .about-assoc-intro__body {
    padding: 0 0.85rem;
    text-align: center;
  }
  .home-page .about-assoc-intro__body p {
    font-size: 0.88rem;
    line-height: 1.55;
    color: #475569;
    overflow-wrap: anywhere;
    margin: 0;
  }
  .home-page .hero-buttons {
    margin-top: 0.25rem;
  }
}

@media (max-width: 440px) {
  .home-page .hero-content h1 { font-size: clamp(1.6rem, 7.5vw, 2.1rem); }
  .home-page .about-assoc-intro__stats .stat-value { font-size: 1.05rem; }
  .home-page .about-assoc-intro__stats .stat-label { font-size: 0.65rem; }
}
  </style>
</head>
<body class="home-page">
  <div class="site-intro" id="site-intro" hidden>
    <canvas class="site-intro__canvas" id="site-intro-canvas" aria-hidden="true"></canvas>
    <div class="site-intro__decor" aria-hidden="true">
      <span class="site-intro__grid"></span>
      <span class="site-intro__beam site-intro__beam--left"></span>
      <span class="site-intro__beam site-intro__beam--right"></span>
      <span class="site-intro__horizon"></span>
    </div>
    <button class="site-intro__skip" id="site-intro-skip" type="button">跳过</button>
    <div class="site-intro__content">
      <div class="site-intro__lens" id="site-intro-lens" aria-hidden="true">
        <span class="site-intro__orbit site-intro__orbit--outer"></span>
        <span class="site-intro__orbit site-intro__orbit--inner"></span>
        <span class="site-intro__reticle"></span>
        <div class="site-intro__emblem">
          <img class="site-intro__emblem-base" src="/image/brand/association-emblem-white.png" alt="">
          <span class="site-intro__emblem-reveal">
            <img src="/image/brand/association-emblem-white.png" alt="">
          </span>
          <span class="site-intro__scan"></span>
        </div>
      </div>
      <p class="site-intro__name">燕山大学无线电爱好者协会</p>
      <div class="site-intro__loading">
        <p class="site-intro__status" role="status" aria-live="polite">正在建立信号连接</p>
        <div class="site-intro__progress" id="site-intro-progress" role="progressbar" aria-label="页面加载进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
          <span class="site-intro__progress-value"></span>
        </div>
        <span class="site-intro__percent" id="site-intro-percent">0%</span>
      </div>
    </div>
  </div>

  <div id="nav-placeholder"></div>

  <!-- Hero 区域 -->
  <header class="hero">
    <div class="hero-bg" aria-hidden="true">
      <canvas id="home-hero-canvas" class="home-hero-canvas"></canvas>
      <div class="home-hero-mesh"></div>
    </div>
    <div class="hero-content container">
      <div class="hero-copy home-hero-copy">
        <h1>
          <span class="hero-title__school">燕山大学</span>
          <span class="hero-title__dept">无线电爱好者协会</span>
        </h1>
        <p>挖掘潜质，就在无协</p>
        <div class="card about-assoc-intro">
          <div class="about-assoc-intro__media">
            <div class="rounded-lg overflow-hidden border bg-gray-100 flex items-center justify-center aspect-video">
              <video controls playsinline preload="none" aria-label="协会招新视频" class="w-full h-full object-cover" poster="/image/activities/farewell/photo-03-1600.webp">
                <source src="/image/video.mp4" type="video/mp4">
                <p class="text-gray-400 text-sm p-8 text-center">视频加载失败，请检查文件是否存在</p>
              </video>
            </div>
          </div>
          <div class="about-assoc-intro__stats">
            <div class="stat-card">
              <div class="stat-value">1988</div>
              <div class="stat-label">成立年份</div>
            </div>
            <div class="stat-card">
              <div class="stat-value">5</div>
              <div class="stat-label">部门数量</div>
            </div>
            <div class="stat-card">
              <div class="stat-value">200+</div>
              <div class="stat-label">会员人数</div>
            </div>
            <div class="stat-card">
              <div class="stat-value">250+</div>
              <div class="stat-label">累计竞赛获奖</div>
            </div>
          </div>
          <div class="about-assoc-intro__body">
            <p class="text-gray-600 leading-relaxed">
              燕山大学无线电爱好者协会，简称"无协"，是技术实践类社团，非常注重教学与实践，已经陪燕大走过<span class="font-semibold text-gray-800">38个春秋</span>。
            </p>
          </div>
        </div>
        <div class="hero-buttons">
          <a href="/html/about-association.html" class="btn-primary hero-btn-primary">了解协会</a>
          <a href="/html/membership-application.html" class="btn-primary hero-btn-secondary">加入我们</a>
        </div>
      </div>
    </div>
  </header>

  <div id="footer-placeholder"></div>

  <button class="scrollTopBtn" title="回到顶部">↑</button>

  <div class="image-viewer">
    <img src="" alt="查看图片">
  </div>

  <script is:inline src="/html/image-assets.js?v=20260819"></script>
  <script is:inline src="/html/common.js?v=20260911"></script>
  <script is:inline src="/html/site-intro.js"></script>
  <script is:inline src="/html/home-effects.js"></script>
</body>
</html>
