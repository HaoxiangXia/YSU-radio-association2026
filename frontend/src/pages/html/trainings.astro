---
import { trainingTimeline, courseScheduleSemester1, courseScheduleSemester2 } from '../../data/trainings';
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>培训教学 - 无线电爱好者协会</title>
  <link rel="icon" href="/favicon.ico">
  <link rel="stylesheet" href="/html/styles.css?v=20260729">
  <style is:global>
.cta-card {
  border-color: rgba(37, 99, 235, 0.2);
  background: #ffffff;
}

/* 时间线 */
.timeline {
  position: relative;
  padding-left: 2rem;
}

.timeline::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 2px;
  background: #93c5fd;
}

.timeline-item {
  position: relative;
  padding-bottom: 1.5rem;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-item::before {
  content: '';
  position: absolute;
  left: -2rem;
  top: 0.375rem;
  width: 10px;
  height: 10px;
  background: var(--color-primary);
  border: 3px solid #eff6ff;
  border-radius: 50%;
  box-shadow: 0 0 0 1px rgba(37, 99, 235, 0.2);
  transform: translateX(-4px);
}

.timeline-date {
  font-size: 0.75rem;
  color: var(--color-primary);
  font-weight: 600;
  margin-bottom: 0.25rem;
}

.timeline-title {
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 0.25rem;
}

.timeline-desc {
  font-size: 0.875rem;
  color: #6b7280;
}

.site-page .timeline::before {
  background: var(--site-blue);
}

.site-page .timeline-item::before {
  box-shadow:
    0 0 0 4px #eff6ff,
    0 0 0 5px rgba(37, 99, 235, 0.18);
}

.site-page.training-page {
  --page-accent: #087f8c;
  --page-accent-soft: rgba(8, 127, 140, 0.09);
}

/* 培训页：编号分区、学习路径与档案 */
.site-page.training-page .training-section {
  border-color: rgba(8, 127, 140, 0.16);
}

.site-page.training-page .training-section__heading {
  margin-bottom: 1rem;
}

.site-page.training-page .training-section__heading .card-title {
  margin-bottom: 0;
  font-size: clamp(1.25rem, 2.5vw, 1.7rem);
}

.site-page.training-page .training-roadmap .timeline-item {
  padding: 0.2rem 0 1.55rem 2rem;
}

.site-page.training-page .training-roadmap .timeline-date {
  color: var(--page-accent);
  font-size: 0.72rem;
  font-weight: 750;
  letter-spacing: 0.06em;
}

.site-page.training-page .training-roadmap .timeline-title {
  color: var(--site-ink);
  font-size: 1rem;
}

.site-page.training-page .training-archive-item {
  display: block;
  margin-bottom: 0.85rem;
  padding: 1rem 1.15rem;
  border-left: 2px solid rgba(8, 127, 140, 0.38);
  box-shadow: none;
}

.site-page.training-page .training-archive-item:last-child {
  margin-bottom: 0;
}

.site-page.training-page .training-archive-item__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem 1.25rem;
  color: var(--site-muted);
  font-size: 0.76rem;
}

.site-page.training-page .training-archive-item__meta span {
  display: inline-flex;
  gap: 0.42rem;
}

.site-page.training-page .training-archive-item__meta strong {
  color: var(--page-accent);
  font-weight: 700;
}

.site-page.training-page .training-cta {
  overflow: hidden;
  border-color: rgba(37, 99, 235, 0.18);
  background: linear-gradient(135deg, #eff6ff 0%, #f0f9ff 52%, #ecfeff 100%);
  box-shadow: 0 14px 32px rgba(37, 99, 235, 0.08);
}

.site-page.training-page .training-cta .card-title {
  color: #102a5a;
  font-size: clamp(1.5rem, 3vw, 2rem);
}

.site-page.training-page .training-cta p {
  color: #526b8e;
}
  </style>
</head>
<body class="site-page sub-page training-page">
  <div id="nav-placeholder"></div>

  <header class="subpage-hero">
    <div class="container subpage-hero__inner">
      <h1>培训教学</h1>
      <p>以工程实践为核心，构建从基础入门到项目协作的学习路径。</p>
    </div>
  </header>

  <main class="page-container subpage-content training-content">
    <!-- 培训时间线 -->
    <section class="card card-section mb-6 training-section training-roadmap">
      <div class="training-section__heading">
        <h2 class="card-title">培训时间线</h2>
      </div>
      <div class="timeline" id="training-timeline">
        {trainingTimeline.map((item) => (
          <div class="timeline-item">
            <div class="timeline-date">{item.date}</div>
            <div class="timeline-title">{item.title}</div>
            <div class="timeline-desc">{item.desc}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- 课程安排 -->
    <section class="card card-section mb-6 training-section training-schedule">
      <div class="training-section__heading">
        <h2 class="card-title">每周课程安排</h2>
      </div>
      <p class="text-gray-600 leading-relaxed">
        2026-2027学年<br>
        coming soon
      </p>
    </section>

    <!-- 往期培训 -->
    <section class="card card-section mb-6 training-section training-archive">
      <div class="training-section__heading">
        <h2 class="card-title">往期培训</h2>
      </div>
      <p class="table-scroll-hint" aria-hidden="true">左右滑动查看更多</p>
      <h3 class="font-bold text-gray-800 mb-2">第一学期</h3>
      <div class="overflow-x-auto mb-4">
        <table class="data-table">
          <thead>
            <tr>
              <th style="width: 5rem;">周次</th>
              <th>课程内容</th>
            </tr>
          </thead>
          <tbody id="course-schedule-1">
            {courseScheduleSemester1.map((item) => (
              <tr>
                <td class="font-medium text-gray-800">{item.week}</td>
                <td class="text-gray-600">{item.content}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <h3 class="font-bold text-gray-800 mb-2">第二学期</h3>
      <div class="overflow-x-auto">
        <table class="data-table">
          <thead>
            <tr>
              <th style="width: 5rem;">周次</th>
              <th>课程内容</th>
            </tr>
          </thead>
          <tbody id="course-schedule-2">
            {courseScheduleSemester2.map((item) => (
              <tr>
                <td class="font-medium text-gray-800">{item.week}</td>
                <td class="text-gray-600">{item.content}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </main>

  <div id="footer-placeholder"></div>

  <button class="scrollTopBtn" title="回到顶部">↑</button>

  <div class="image-viewer">
    <img src="" alt="查看图片">
  </div>

  <script is:inline src="/html/image-assets.js?v=20260729"></script>
  <script is:inline src="/html/common.js?v=20260729"></script>
</body>
</html>
