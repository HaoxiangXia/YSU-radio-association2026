---
import SubpageLayout from '../../layouts/SubpageLayout.astro';
---
<SubpageLayout
  title="招新设置与录取结果 - 无线电爱好者协会"
  bodyClass="site-page sub-page recruitment-officer-page recruitment-operations-page"
  heroTitle="招新设置与录取结果"
  heroDesc="管理招新开放安排，并安全预览和发布录取名单。"
  mainClass="operations-grid"
  heroCompact
>
  <style is:global>
/* 招新设置页：扁平、单层卡片设计，杜绝卡片套卡片；兼顾桌面端清晰层级与移动端舒适排版 */
.site-page.recruitment-operations-page {
  --page-accent: #2563eb;
  --page-accent-dark: #1d4ed8;
  --page-accent-soft: rgba(37, 99, 235, 0.08);
  --page-border: #e2e8f0;
  --page-border-hairline: #f1f5f9;
  --page-text-main: #0f172a;
  --page-text-sub: #334155;
  --page-text-muted: #64748b;
  background-color: #f8fafc;
}

.site-page.recruitment-operations-page .page-container.subpage-content::before {
  content: none;
}

.operations-grid {
  display: grid;
  gap: 1.25rem;
  max-width: 100%;
}

/* 顶部导航与快捷操作工具栏 */
.operations-toolbar {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  align-items: center;
  justify-content: space-between;
}

.operations-toolbar__group {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
}

.btn-nav-back {
  background: #ffffff !important;
  color: var(--page-text-sub) !important;
  border: 1px solid var(--page-border) !important;
}

.btn-nav-back:hover {
  background: #f8fafc !important;
  color: var(--page-accent) !important;
  border-color: #cbd5e1 !important;
}

/* 按钮通用体系（主按钮、次级线框按钮） */
.site-page.recruitment-operations-page .btn-solid {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.625rem 1.25rem;
  min-height: 44px;
  border-radius: 8px;
  background: var(--page-accent);
  color: #ffffff;
  border: 1px solid var(--page-accent);
  font-weight: 600;
  font-size: 0.9375rem;
  text-decoration: none;
  cursor: pointer;
  transition: background-color 0.15s ease, border-color 0.15s ease;
  box-shadow: none;
}

.site-page.recruitment-operations-page .btn-solid:hover:not(:disabled) {
  background: var(--page-accent-dark);
  border-color: var(--page-accent-dark);
}

.site-page.recruitment-operations-page .btn-solid:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

.site-page.recruitment-operations-page .btn-outline {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.625rem 1.125rem;
  min-height: 44px;
  border-radius: 8px;
  background: #ffffff;
  color: var(--page-text-sub);
  border: 1px solid #cbd5e1;
  font-weight: 500;
  font-size: 0.9375rem;
  text-decoration: none;
  cursor: pointer;
  transition: all 0.15s ease;
  box-shadow: none;
}

.site-page.recruitment-operations-page .btn-outline:hover:not(:disabled) {
  background: #f8fafc;
  color: var(--page-accent);
  border-color: var(--page-accent);
}

.site-page.recruitment-operations-page .btn-outline:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* 单层卡片：仅外层为卡片，内部不嵌套子卡片 */
.operations-card {
  padding: clamp(1.25rem, 2.5vw, 1.75rem);
  border: 1px solid var(--page-border);
  border-radius: 10px;
  background: #ffffff;
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
}

/* 卡片标题区 */
.operations-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  margin-bottom: 1.25rem;
  padding-bottom: 0.75rem;
  border-bottom: 1px solid var(--page-border-hairline);
}

.operations-heading__title-wrap {
  flex: 1 1 auto;
  min-width: 0;
}

.operations-heading h2 {
  margin: 0;
  font-size: 1.2rem;
  font-weight: 700;
  color: var(--page-text-main);
  position: relative;
  padding-left: 0.75rem;
  line-height: 1.4;
}

.operations-heading h2::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  width: 3.5px;
  height: 1.1em;
  border-radius: 2px;
  background: var(--page-accent);
  transform: translateY(-50%);
}

.operations-heading__sub {
  margin: 0.2rem 0 0;
  color: var(--page-text-muted);
  font-size: 0.8125rem;
  line-height: 1.4;
}

.operations-heading__actions {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

/* 表单分段（纯空白与细分割线，无嵌套卡片底色与边框） */
.operations-form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1.25rem;
}

.operations-section {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1.1rem 1.25rem;
  padding-top: 1.25rem;
  border-top: 1px solid var(--page-border-hairline);
}

.operations-section:first-of-type {
  padding-top: 0;
  border-top: none;
}

.operations-section__header {
  grid-column: 1 / -1;
  margin-bottom: 0.15rem;
}

.operations-section__title {
  margin: 0;
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--page-text-main);
}

.operations-section__desc {
  margin: 0.2rem 0 0;
  font-size: 0.8125rem;
  color: var(--page-text-muted);
}

.operations-field--wide {
  grid-column: 1 / -1;
}

.form-group-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.35rem;
}

.site-page.recruitment-operations-page .form-label {
  display: block;
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--page-text-sub);
  margin-bottom: 0.35rem;
}

.form-group-header .form-label {
  margin-bottom: 0;
}

.form-badge {
  display: inline-block;
  padding: 0.125rem 0.5rem;
  border-radius: 4px;
  background: #eff6ff;
  color: var(--page-accent);
  font-size: 0.75rem;
  font-weight: 600;
}

/* 输入框通用 */
.site-page.recruitment-operations-page .form-input {
  width: 100%;
  padding: 0.625rem 0.875rem;
  min-height: 44px;
  border: 1px solid #cbd5e1;
  border-radius: 8px;
  background: #ffffff;
  color: var(--page-text-main);
  font-size: 16px; /* 移动端禁止 iOS Safari 聚焦时视口自动缩放 */
  line-height: 1.5;
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
  box-sizing: border-box;
}

.site-page.recruitment-operations-page .form-input:focus {
  border-color: var(--page-accent);
  box-shadow: 0 0 0 3px var(--page-accent-soft);
  outline: none;
}

.site-page.recruitment-operations-page textarea.form-input {
  min-height: auto;
  resize: vertical;
}

/* 开关行（平铺列表式行结构，非嵌套卡片） */
.operations-toggle-row {
  grid-column: 1 / -1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.25rem;
  padding: 0.75rem 0;
  border-bottom: 1px solid var(--page-border-hairline);
  cursor: pointer;
  user-select: none;
  -webkit-user-select: none;
  min-height: 48px;
}

.operations-toggle-row:last-child {
  border-bottom: none;
}

.operations-toggle-row input {
  position: absolute;
  opacity: 0;
  pointer-events: none;
  width: 0;
  height: 0;
}

.operations-toggle-row__content {
  flex: 1 1 auto;
  min-width: 0;
}

.operations-toggle-row__label {
  display: block;
  font-size: 0.9375rem;
  font-weight: 600;
  color: var(--page-text-main);
}

.operations-toggle-row__desc {
  margin: 0.2rem 0 0;
  color: var(--page-text-muted);
  font-size: 0.8125rem;
  line-height: 1.45;
}

.operations-toggle-switch {
  flex: 0 0 auto;
  width: 2.75rem;
  height: 1.55rem;
  border-radius: 999px;
  background: #cbd5e1;
  position: relative;
  transition: background-color 0.2s ease;
}

.operations-toggle-switch::after {
  content: '';
  position: absolute;
  top: 0.175rem;
  left: 0.2rem;
  width: 1.2rem;
  height: 1.2rem;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.25);
  transition: transform 0.2s ease;
}

.operations-toggle-row input:checked + .operations-toggle-switch {
  background: var(--page-accent);
}

.operations-toggle-row input:checked + .operations-toggle-switch::after {
  transform: translateX(1.2rem);
}

.operations-toggle-row input:focus-visible + .operations-toggle-switch {
  outline: 3px solid var(--page-accent-soft);
  outline-offset: 2px;
}

/* 申请时间并排区域（直接平铺，无嵌套虚线框） */
.operations-dates-row {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1.1rem 1.25rem;
  padding: 0.25rem 0 0.5rem;
}

.operations-help {
  margin-top: 0.35rem;
  color: var(--page-text-muted);
  font-size: 0.8125rem;
  line-height: 1.5;
}

/* 表单底部操作区 */
.operations-form-footer {
  grid-column: 1 / -1;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  padding-top: 1.25rem;
  margin-top: 0.5rem;
  border-top: 1px solid var(--page-border);
}

.operations-form-footer__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  align-items: center;
}

.btn-save {
  padding: 0.75rem 2rem !important;
  font-size: 1rem !important;
}

/* 状态提示 */
.operations-feedback {
  min-height: 1.5rem;
  margin: 0;
  color: #166534;
  font-size: 0.875rem;
  line-height: 1.5;
  display: flex;
  align-items: center;
}

.operations-feedback.is-error {
  color: #b91c1c;
}

/* 录取名单管理区（直接平铺，无嵌套步骤卡片） */
.admissions-status-line {
  margin: 0 0 1.25rem;
  padding: 0.65rem 0.875rem;
  border-left: 3px solid var(--page-accent);
  background: #f8fafc;
  border-radius: 0 6px 6px 0;
}

.admissions-status {
  margin: 0;
  color: var(--page-text-sub);
  font-size: 0.9rem;
  line-height: 1.5;
}

.admissions-controls-group {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  align-items: center;
  margin-bottom: 0.75rem;
}

.admissions-file-input {
  flex: 1 1 14rem;
  padding: 0.5rem 0.75rem;
}

/* 预览表格与错误 */
#preview-result {
  margin-top: 1.25rem;
  padding-top: 1.25rem;
  border-top: 1px dashed var(--page-border);
}

.preview-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin: 0 0 1rem;
}

.preview-summary span {
  padding: 0.35rem 0.8rem;
  border: 1px solid #dbeafe;
  border-radius: 999px;
  background: #eff6ff;
  color: var(--page-accent-dark);
  font-size: 0.8125rem;
  font-weight: 600;
}

.preview-table-wrap {
  overflow-x: auto;
  border: 1px solid var(--page-border);
  border-radius: 8px;
  background: #ffffff;
  max-width: 100%;
  -webkit-overflow-scrolling: touch;
}

.preview-table {
  width: 100%;
  min-width: 24rem;
  border-collapse: collapse;
}

.preview-table th,
.preview-table td {
  padding: 0.65rem 0.85rem;
  border-bottom: 1px solid var(--page-border);
  text-align: left;
  font-size: 0.875rem;
}

.preview-table thead th {
  background: #f8fafc;
  color: #334155;
  font-weight: 600;
}

.preview-table tbody tr:last-child td {
  border-bottom: none;
}

.preview-errors {
  margin: 0.75rem 0;
  padding-left: 1.2rem;
  color: #b91c1c;
  font-size: 0.875rem;
}

.preview-publish-actions {
  margin-top: 1rem;
  display: flex;
  justify-content: flex-end;
}

/* 数据导出直接行排版（无嵌套卡片） */
.export-content-row {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  align-items: center;
  justify-content: space-between;
}

.export-content-row p {
  flex: 1 1 20rem;
  margin: 0;
  color: var(--page-text-muted);
  font-size: 0.875rem;
  line-height: 1.5;
}

/* 手机端响应式优化 (<= 768px) */
@media (max-width: 768px) {
  .operations-grid {
    gap: 1rem;
  }

  .operations-card {
    padding: 1.125rem 1rem;
  }

  .operations-heading {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.875rem;
    padding-bottom: 0.625rem;
  }

  .operations-heading__title-wrap {
    flex: 1 1 auto;
    min-width: 0;
  }

  .operations-heading h2 {
    font-size: 1.05rem;
    line-height: 1.3;
  }

  .operations-heading__sub {
    font-size: 0.75rem;
    margin-top: 0.15rem;
    line-height: 1.35;
  }

  .operations-heading__actions {
    flex: 0 0 auto;
    width: auto;
  }

  .operations-heading__actions button {
    width: auto;
    min-height: 44px;
    padding: 0.4rem 0.875rem;
    font-size: 0.875rem;
  }
  .operations-form-grid,
  .operations-section,
  .operations-dates-row {
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .operations-field--wide,
  .operations-section__header {
    grid-column: auto;
  }

  .operations-toolbar .btn-solid,
  .operations-form-footer__actions button,
  .admissions-controls-group > *,
  .export-content-row button {
    width: 100%;
    min-height: 44px;
  }

  .preview-publish-actions {
    justify-content: stretch;
  }

  .preview-publish-actions button {
    width: 100%;
    min-height: 44px;
  }

  .preview-table {
    min-width: 18rem;
  }
}
  </style>

  <div class="operations-toolbar" aria-label="负责人页面导航">
    <div class="operations-toolbar__group">
      <a class="btn-solid btn-nav-back" href="/html/membership-applications.html">← 返回入会申请管理</a>
    </div>
    <!-- 退出登录按钮由 common.js 移入导航栏最右端 -->
    <button class="btn-solid" type="button" id="logout-button">退出登录</button>
  </div>

  <!-- 招新业务设置（单层卡片） -->
  <section class="card operations-card" aria-labelledby="config-heading">
    <div class="operations-heading">
      <div class="operations-heading__title-wrap">
        <h2 id="config-heading">招新业务设置</h2>
        <p class="operations-heading__sub">保存后立即生效，请仔细核对。</p>
      </div>
      <div class="operations-heading__actions">
        <button class="btn-outline" type="button" id="reload-config-button">重新读取</button>
      </div>
    </div>

    <form id="config-form" class="operations-form-grid">
      <!-- Section 1: 核心开关与展示控制 -->
      <div class="operations-section">
        <div class="operations-section__header">
          <h3 class="operations-section__title">核心开关与展示控制</h3>
          <p class="operations-section__desc">控制学生端报名、录取结果查询和全站顶部横幅的开放与展示状态。</p>
        </div>

        <label class="operations-toggle-row" for="application-enabled">
          <span class="operations-toggle-row__content">
            <span class="operations-toggle-row__label">开放入会申请</span>
            <span class="operations-toggle-row__desc">学生端申请表单总开关。需开关开启且当前时间处于起止时间内方可提交。</span>
          </span>
          <input id="application-enabled" name="applicationEnabled" type="checkbox">
          <span class="operations-toggle-switch" aria-hidden="true"></span>
        </label>

        <div class="operations-dates-row">
          <div>
            <label class="form-label" for="starts-at">申请开始时间</label>
            <input class="form-input" id="starts-at" name="startsAt" type="datetime-local">
          </div>
          <div>
            <label class="form-label" for="ends-at">申请截止时间</label>
            <input class="form-input" id="ends-at" name="endsAt" type="datetime-local">
          </div>
        </div>

        <label class="operations-toggle-row" for="admission-enabled">
          <span class="operations-toggle-row__content">
            <span class="operations-toggle-row__label">开放录取查询</span>
            <span class="operations-toggle-row__desc">允许学生输入学号查询录取结果。发布新名单前必须先关闭本开关。</span>
          </span>
          <input id="admission-enabled" name="admissionEnabled" type="checkbox">
          <span class="operations-toggle-switch" aria-hidden="true"></span>
        </label>

        <label class="operations-toggle-row" for="banner-enabled">
          <span class="operations-toggle-row__content">
            <span class="operations-toggle-row__label">显示顶部横幅</span>
            <span class="operations-toggle-row__desc">在全站页面顶部展示招新公告横幅（作品提交通道与招新题组发布通知）。</span>
          </span>
          <input id="banner-enabled" name="bannerEnabled" type="checkbox">
          <span class="operations-toggle-switch" aria-hidden="true"></span>
        </label>
      </div>

      <!-- Section 2: 招新周期与基础信息 -->
      <div class="operations-section">
        <div class="operations-section__header">
          <h3 class="operations-section__title">招新周期与基础信息</h3>
        </div>
        <div>
          <label class="form-label" for="cycle">招新周期</label>
          <input class="form-input" id="cycle" name="cycle" maxlength="50" required placeholder="如：2026">
        </div>
        <div>
          <label class="form-label" for="retention-until">资料保留至</label>
          <input class="form-input" id="retention-until" name="retentionUntil" type="date">
        </div>
        <div class="operations-field--wide">
          <label class="form-label" for="icp-number">网站 ICP 备案号（可留空）</label>
          <input class="form-input" id="icp-number" name="icpNumber" maxlength="100" placeholder="如：冀ICP备xxxxxxxx号">
        </div>
      </div>

      <!-- Section 3: 咨询与联系方式 -->
      <div class="operations-section">
        <div class="operations-section__header">
          <h3 class="operations-section__title">咨询与联系方式</h3>
          <p class="operations-section__desc">展示在入会申请表单下方及网站公共页脚中。</p>
        </div>
        <div>
          <label class="form-label" for="contact-label">联系方式标题</label>
          <input class="form-input" id="contact-label" name="contactLabel" maxlength="100" required placeholder="如：招新通知方式">
        </div>
        <div>
          <label class="form-label" for="contact-qq">QQ 群号（可留空）</label>
          <input class="form-input" id="contact-qq" name="contactQq" maxlength="30" inputmode="numeric" placeholder="如：836660390">
        </div>
        <div class="operations-field--wide">
          <label class="form-label" for="contact-qq-link">QQ 群加群链接（可留空）</label>
          <input class="form-input" id="contact-qq-link" name="contactQqLink" maxlength="500" type="url" placeholder="https://qm.qq.com/q/...">
        </div>
        <div class="operations-field--wide">
          <label class="form-label" for="contact-channel">联系补充说明</label>
          <textarea class="form-input" id="contact-channel" name="contactChannel" rows="2" maxlength="500" required placeholder="如：请加入协会招新 QQ 群获取后续面试与录取通知。"></textarea>
        </div>
      </div>

      <!-- Section 4: 法律与告知文案 -->
      <div class="operations-section">
        <div class="operations-section__header">
          <h3 class="operations-section__title">法律与告知文案</h3>
          <p class="operations-section__desc">学生提交入会申请前需明确确认知晓的重要声明。</p>
        </div>
        <div class="operations-field--wide">
          <label class="form-label" for="privacy-notice">个人信息处理说明</label>
          <textarea class="form-input" id="privacy-notice" name="privacyNotice" rows="3" maxlength="1500" required></textarea>
        </div>
        <div class="operations-field--wide">
          <label class="form-label" for="cross-border-notice">香港服务器存储说明</label>
          <textarea class="form-input" id="cross-border-notice" name="crossBorderNotice" rows="3" maxlength="1500" required></textarea>
          <p class="operations-help">正式开放前必须由负责人确认此告知文字；学生会在申请页单独勾选同意。</p>
        </div>
      </div>

      <!-- Section 5: 申请表单选项配置 -->
      <div class="operations-section">
        <div class="operations-section__header">
          <h3 class="operations-section__title">申请表单选项配置</h3>
          <p class="operations-section__desc">配置学生端报名时可选的学院与年级下拉列表，每行一项。</p>
        </div>
        <div>
          <div class="form-group-header">
            <label class="form-label" for="colleges">学院选项（每行一项）</label>
            <span class="form-badge" id="colleges-count">0 项</span>
          </div>
          <textarea class="form-input" id="colleges" name="colleges" rows="6" required></textarea>
        </div>
        <div>
          <div class="form-group-header">
            <label class="form-label" for="grades">年级选项（每行一项）</label>
            <span class="form-badge" id="grades-count">0 项</span>
          </div>
          <textarea class="form-input" id="grades" name="grades" rows="6" required></textarea>
        </div>
      </div>

      <div class="operations-form-footer">
        <div class="operations-form-footer__actions">
          <button class="btn-solid btn-save" type="submit" id="save-config-button">检查并保存设置</button>
        </div>
        <p class="operations-feedback" id="config-feedback" role="status"></p>
      </div>
    </form>
  </section>

  <!-- 入会申请数据导出（单层卡片） -->
  <section class="card operations-card" aria-labelledby="export-heading">
    <div class="operations-heading">
      <div class="operations-heading__title-wrap">
        <h2 id="export-heading">入会申请数据导出</h2>
        <p class="operations-heading__sub">导出申请数据为 CSV 文件用于离线分析。</p>
      </div>
    </div>
    <div class="export-content-row">
      <p>生成的 CSV 文件包含姓名、学号、学院、年级、手机、QQ、申请说明与提交时间等完整字段，支持使用 Excel 或 WPS 直接打开。</p>
      <button class="btn-outline" type="button" id="export-csv-button">导出 CSV 文件</button>
    </div>
    <p class="operations-feedback" id="export-feedback" role="status"></p>
  </section>

  <!-- 录取名单发布与管理（单层卡片） -->
  <section class="card operations-card" aria-labelledby="admissions-heading">
    <div class="operations-heading">
      <div class="operations-heading__title-wrap">
        <h2 id="admissions-heading">录取名单管理</h2>
        <p class="operations-heading__sub">发布前须先关闭录取查询。</p>
      </div>
      <div class="operations-heading__actions">
        <button class="btn-outline" type="button" id="reload-admissions-button">刷新状态</button>
      </div>
    </div>

    <div class="admissions-status-line">
      <p class="admissions-status" id="admissions-status">正在读取录取名单状态。</p>
    </div>

    <div class="admissions-controls-group">
      <button class="btn-outline" type="button" id="download-template-button">下载 Excel 模板</button>
      <input class="form-input admissions-file-input" id="admissions-file" type="file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet">
      <button class="btn-solid" type="button" id="preview-button">校验并预览</button>
    </div>
    <p class="operations-help">只接受 2 MiB 以内的 .xlsx 文件，工作表名为“录取名单”，仅含“姓名、学号”两列，最多 2000 条。名单中所有同学均视为已录取。</p>

    <div id="preview-result" hidden>
      <div class="preview-summary" id="preview-summary"></div>
      <ul class="preview-errors" id="preview-errors"></ul>
      <div class="preview-table-wrap">
        <table class="preview-table">
          <thead><tr><th>姓名</th><th>学号</th></tr></thead>
          <tbody id="preview-body"></tbody>
        </table>
      </div>
      <div class="preview-publish-actions">
        <button class="btn-solid" type="button" id="publish-button" disabled>确认发布此名单</button>
      </div>
    </div>
    <p class="operations-feedback" id="admissions-feedback" role="status"></p>
  </section>

  <!-- CSV 导出提示弹窗 -->
  <div id="csv-modal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="csv-modal-title">
    <div class="modal-card">
      <h3 id="csv-modal-title">入会申请数据导出</h3>
      <p id="csv-modal-message">正在生成 CSV…</p>
      <div class="modal-actions">
        <button class="btn-solid" type="button" id="csv-modal-close">确定</button>
      </div>
    </div>
  </div>

  <script>
    let currentPreviewId = null;
    let admissionQueryEnabled = false;

    function clearAuthAndRedirect() {
      window.location.href = '/html/admin-login.html';
    }

    async function logout() {
      try {
        await fetch('/api/recruitment-officers/logout', { method: 'POST' });
      } catch (error) {}
      clearAuthAndRedirect();
    }

    async function checkedResponse(response) {
      if (response.status === 401 || response.status === 403) {
        clearAuthAndRedirect();
        throw new Error('登录已失效');
      }
      if (!response.ok) {
        const body = await response.json().catch(() => ({}));
        const detail = Array.isArray(body.detail)
          ? body.detail.map((item) => item.msg).join('；')
          : body.detail;
        throw new Error(detail || body.message || '请求失败');
      }
      return response;
    }

    function setFeedback(id, message = '', isError = false) {
      const element = document.getElementById(id);
      if (!element) return;
      element.textContent = message;
      element.classList.toggle('is-error', isError);
    }

    function toLocalInput(isoValue) {
      if (!isoValue) return '';
      const date = new Date(isoValue);
      const local = new Date(date.getTime() - date.getTimezoneOffset() * 60000);
      return local.toISOString().slice(0, 16);
    }

    function toIsoValue(localValue) {
      return localValue ? new Date(localValue).toISOString() : null;
    }

    function lines(value) {
      return [...new Set(value.split(/\r?\n/).map((item) => item.trim()).filter(Boolean))];
    }

    function updateOptionCounts() {
      const form = document.getElementById('config-form');
      if (!form) return;
      const collegesCount = lines(form.elements.colleges.value).length;
      const gradesCount = lines(form.elements.grades.value).length;
      const cEl = document.getElementById('colleges-count');
      const gEl = document.getElementById('grades-count');
      if (cEl) cEl.textContent = `共 ${collegesCount} 所`;
      if (gEl) gEl.textContent = `共 ${gradesCount} 个`;
    }

    function fillConfig(config) {
      const form = document.getElementById('config-form');
      form.elements.cycle.value = config.cycle;
      form.elements.retentionUntil.value = config.application.retentionUntil || '';
      form.elements.applicationEnabled.checked = config.application.enabled === true;
      form.elements.startsAt.value = toLocalInput(config.application.startsAt);
      form.elements.endsAt.value = toLocalInput(config.application.endsAt);
      form.elements.privacyNotice.value = config.application.privacyNotice;
      form.elements.crossBorderNotice.value = config.application.crossBorderNotice;
      form.elements.admissionEnabled.checked = config.admissionQuery.enabled === true;
      form.elements.bannerEnabled.checked = config.banner?.enabled !== false;
      form.elements.contactLabel.value = config.contact.label;
      form.elements.contactQq.value = config.contact.qq || '';
      form.elements.contactQqLink.value = config.contact.qqLink || '';
      form.elements.contactChannel.value = config.contact.channelText;
      form.elements.colleges.value = config.options.colleges.join('\n');
      form.elements.grades.value = config.options.grades.join('\n');
      form.elements.icpNumber.value = config.site.icpNumber || '';
      admissionQueryEnabled = config.admissionQuery.enabled === true;
      updateOptionCounts();
    }

    async function loadConfig() {
      setFeedback('config-feedback', '正在读取设置。');
      try {
        const response = await checkedResponse(await fetch('/api/recruitment/manage/config'));
        const body = await response.json();
        fillConfig(body.config);
        setFeedback('config-feedback', `已读取 ${body.config.cycle} 招新周期设置。`);
      } catch (error) {
        setFeedback('config-feedback', error.message, true);
      }
    }

    function configFromForm() {
      const form = document.getElementById('config-form');
      return {
        cycle: form.elements.cycle.value.trim(),
        application: {
          enabled: form.elements.applicationEnabled.checked,
          startsAt: toIsoValue(form.elements.startsAt.value),
          endsAt: toIsoValue(form.elements.endsAt.value),
          privacyNotice: form.elements.privacyNotice.value.trim(),
          crossBorderNotice: form.elements.crossBorderNotice.value.trim(),
          retentionUntil: form.elements.retentionUntil.value || null,
        },
        admissionQuery: {
          enabled: form.elements.admissionEnabled.checked,
        },
        banner: {
          enabled: form.elements.bannerEnabled.checked,
        },
        contact: {
          label: form.elements.contactLabel.value.trim(),
          qq: form.elements.contactQq.value.trim(),
          qqLink: form.elements.contactQqLink.value.trim(),
          channelText: form.elements.contactChannel.value.trim(),
        },
        options: {
          colleges: lines(form.elements.colleges.value),
          grades: lines(form.elements.grades.value),
        },
        site: { icpNumber: form.elements.icpNumber.value.trim() },
      };
    }

    async function saveConfig(event) {
      event.preventDefault();
      const config = configFromForm();
      const summary = [
        `招新周期：${config.cycle}`,
        `入会申请：${config.application.enabled ? '开启' : '关闭'}`,
        `录取查询：${config.admissionQuery.enabled ? '开启' : '关闭'}`,
        `顶部横幅：${config.banner.enabled ? '显示' : '隐藏'}`,
        `学院/年级选项：${config.options.colleges.length}/${config.options.grades.length}`,
      ].join('\n');
      if (!window.confirm(`请确认保存以下设置：\n\n${summary}`)) return;

      const button = document.getElementById('save-config-button');
      button.disabled = true;
      setFeedback('config-feedback', '正在校验并保存。');
      try {
        const response = await checkedResponse(await fetch('/api/recruitment/manage/config', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(config),
        }));
        const body = await response.json();
        fillConfig(body.config);
        setFeedback('config-feedback', body.changedFields.length
          ? `保存成功，已更新 ${body.changedFields.length} 个字段。`
          : '配置内容没有变化。');
        await loadAdmissionsStatus();
      } catch (error) {
        setFeedback('config-feedback', error.message, true);
      } finally {
        button.disabled = false;
      }
    }

    async function loadAdmissionsStatus() {
      try {
        const response = await checkedResponse(await fetch('/api/admissions/manage/status'));
        const status = await response.json();
        admissionQueryEnabled = status.queryEnabled === true;
        let message = status.published
          ? `已发布 ${status.count ?? '未知'} 条录取结果`
          : '尚未发布录取名单';
        if (!status.valid) message += '，但当前名单校验失败';
        message += `；录取查询当前${status.queryEnabled ? '已开放' : '已关闭'}。`;
        document.getElementById('admissions-status').textContent = message;
      } catch (error) {
        document.getElementById('admissions-status').textContent = `状态读取失败：${error.message}`;
      }
    }

    async function downloadTemplate() {
      setFeedback('admissions-feedback', '正在生成模板。');
      try {
        const response = await checkedResponse(await fetch('/api/admissions/manage/template.xlsx'));
        const blob = await response.blob();
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = '录取名单模板.xlsx';
        document.body.appendChild(link);
        link.click();
        link.remove();
        URL.revokeObjectURL(url);
        setFeedback('admissions-feedback', '模板已下载。');
      } catch (error) {
        setFeedback('admissions-feedback', error.message, true);
      }
    }

    function renderPreview(body) {
      document.getElementById('preview-result').hidden = false;
      const summary = document.getElementById('preview-summary');
      summary.replaceChildren();
      const labels = [
        `总计 ${body.summary.total}`,
        `已录取 ${body.summary.accepted}`,
        `未录取 ${body.summary.rejected}`,
        `错误 ${body.summary.errors}`,
      ];
      labels.forEach((label) => {
        const item = document.createElement('span');
        item.textContent = label;
        summary.appendChild(item);
      });

      const errors = document.getElementById('preview-errors');
      errors.replaceChildren();
      body.errors.forEach((error) => {
        const item = document.createElement('li');
        item.textContent = `第 ${error.row} 行：${error.message}`;
        errors.appendChild(item);
      });

      const previewBody = document.getElementById('preview-body');
      previewBody.replaceChildren();
      body.preview.forEach((record) => {
        const row = document.createElement('tr');
        ['name', 'studentId'].forEach((field) => {
          const cell = document.createElement('td');
          cell.textContent = record[field] || '-';
          row.appendChild(cell);
        });
        previewBody.appendChild(row);
      });

      currentPreviewId = body.valid ? body.previewId : null;
      const publishButton = document.getElementById('publish-button');
      publishButton.disabled = !currentPreviewId || admissionQueryEnabled;
      publishButton.title = admissionQueryEnabled ? '请先在上方关闭录取查询并保存' : '';
    }

    async function previewWorkbook() {
      const input = document.getElementById('admissions-file');
      const file = input.files[0];
      if (!file) {
        setFeedback('admissions-feedback', '请先选择 Excel 文件。', true);
        return;
      }
      if (!file.name.toLowerCase().endsWith('.xlsx') || file.size > 2 * 1024 * 1024) {
        setFeedback('admissions-feedback', '请选择 2 MiB 以内的 .xlsx 文件。', true);
        return;
      }
      const button = document.getElementById('preview-button');
      button.disabled = true;
      setFeedback('admissions-feedback', '正在校验录取名单。');
      try {
        const response = await checkedResponse(await fetch('/api/admissions/manage/preview', {
          method: 'POST',
          headers: { 'Content-Type': 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' },
          body: file,
        }));
        const body = await response.json();
        renderPreview(body);
        setFeedback('admissions-feedback', body.valid
          ? '校验通过。预览只显示脱敏内容，请确认后再发布。'
          : '校验未通过，请修正错误行后重新上传。', !body.valid);
      } catch (error) {
        currentPreviewId = null;
        document.getElementById('publish-button').disabled = true;
        setFeedback('admissions-feedback', error.message, true);
      } finally {
        button.disabled = false;
      }
    }

    async function publishAdmissions() {
      if (!currentPreviewId) return;
      if (admissionQueryEnabled) {
        setFeedback('admissions-feedback', '请先关闭录取查询再发布。', true);
        return;
      }
      if (!window.confirm('发布会替换当前录取名单并保留旧名单备份。确定继续吗？')) return;
      const button = document.getElementById('publish-button');
      button.disabled = true;
      setFeedback('admissions-feedback', '正在发布录取名单。');
      try {
        const response = await checkedResponse(await fetch('/api/admissions/manage/publish', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ previewId: currentPreviewId }),
        }));
        const body = await response.json();
        currentPreviewId = null;
        document.getElementById('preview-result').hidden = true;
        document.getElementById('admissions-file').value = '';
        setFeedback('admissions-feedback', `${body.message}，共 ${body.count} 条。`);
        await loadAdmissionsStatus();
      } catch (error) {
        button.disabled = false;
        setFeedback('admissions-feedback', error.message, true);
      }
    }

    async function exportCsv() {
      const button = document.getElementById('export-csv-button');
      const modal = document.getElementById('csv-modal');
      const message = document.getElementById('csv-modal-message');
      const closeBtn = document.getElementById('csv-modal-close');

      button.disabled = true;
      message.textContent = '正在生成 CSV…';
      closeBtn.style.display = 'none';
      modal.classList.add('open');

      try {
        const response = await checkedResponse(await fetch('/api/membership-applications/export.csv'));
        const blob = await response.blob();
        const link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        const disposition = response.headers.get('Content-Disposition') || '';
        const filenameMatch = disposition.match(/filename="([^"]+)"/);
        link.download = filenameMatch?.[1] || 'membership-applications.csv';
        link.click();
        URL.revokeObjectURL(link.href);
        const count = response.headers.get('X-Export-Count');
        message.textContent = count === null ? 'CSV 已生成。' : `CSV 已生成，共 ${count} 条。`;
        closeBtn.style.display = '';
      } catch (error) {
        message.textContent = error.message || '导出失败，请稍后重试。';
        closeBtn.style.display = '';
      } finally {
        button.disabled = false;
      }
    }

    (async () => {
      try {
        const session = await fetch('/api/recruitment-officers/verify');
        if (!session.ok) {
          clearAuthAndRedirect();
          return;
        }
      } catch (error) {
        clearAuthAndRedirect();
        return;
      }
      document.getElementById('config-form').addEventListener('submit', saveConfig);
      document.getElementById('reload-config-button').addEventListener('click', loadConfig);
      document.getElementById('reload-admissions-button').addEventListener('click', loadAdmissionsStatus);
      document.getElementById('download-template-button').addEventListener('click', downloadTemplate);
      document.getElementById('preview-button').addEventListener('click', previewWorkbook);
      document.getElementById('publish-button').addEventListener('click', publishAdmissions);
      document.getElementById('logout-button').addEventListener('click', logout);
      document.getElementById('export-csv-button').addEventListener('click', exportCsv);
      document.getElementById('csv-modal-close').addEventListener('click', () => {
        document.getElementById('csv-modal').classList.remove('open');
      });
      document.getElementById('colleges').addEventListener('input', updateOptionCounts);
      document.getElementById('grades').addEventListener('input', updateOptionCounts);

      await loadConfig();
      await loadAdmissionsStatus();
    })();
  </script>
</SubpageLayout>
