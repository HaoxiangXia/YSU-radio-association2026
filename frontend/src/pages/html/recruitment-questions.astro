---
import SubpageLayout from '../../layouts/SubpageLayout.astro';
import { getEntry, render } from 'astro:content';

const pythonEntry = await getEntry('questions', 'python');
const cEntry = await getEntry('questions', 'c');
const qrsEntry = await getEntry('questions', 'qrs');
if (!pythonEntry || !cEntry || !qrsEntry) throw new Error('题组内容缺失');
const { Content: PythonContent } = await render(pythonEntry);
const { Content: CContent } = await render(cEntry);
const { Content: QrsContent } = await render(qrsEntry);
---
<SubpageLayout
  title="招新题组 - 无线电爱好者协会"
  bodyClass="site-page sub-page recruitment-questions-page"
  heroTitle="招新题组"
  heroDesc="各部门招新参考题组，报名前可以先看看对应部门的题目。"
  mainClass="questions-content"
  heroCompact
  navMode="custom"
>
  <link slot="head" rel="stylesheet" href="/html/vendor/katex.min.css">
  <nav slot="nav" class="nav questions-nav">
    <div class="container questions-nav__inner">
      <a href="/html/index.html" class="nav-logo">
        <img src="/image/brand/association-emblem-white.png" alt="会徽">
        <span>无线电爱好者协会</span>
      </a>
      <span class="nav-links"><a href="/html/membership-application.html" class="questions-nav__back"><span class="questions-nav__back-full">返回入会申请页面</span><span class="questions-nav__back-short">返回</span></a></span>
    </div>
  </nav>
  <style is:global>
/* 招新题组页：tab 切换复用管理员页 chart-tab 模式 */
.recruitment-questions-page {
  --page-accent: #2563eb;
}

/* 页内自定义导航：左返回链接，右 logo */
.questions-nav__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 4rem;
}

/* 返回链接复用全局 .nav-links a 样式（同导航栏"录取查询"等链接） */
.questions-nav .nav-links a {
  text-decoration: none;
}

.questions-nav__back-short {
  display: none;
}

/* 移动端返回链接：与全局汉堡菜单按钮同款的方按钮 */
@media (max-width: 900px) {
  .questions-nav .nav-links {
    display: flex;
    margin-left: auto;
  }

  .questions-nav__back-full {
    display: none;
  }

  .questions-nav__back-short {
    display: inline;
  }

  .questions-nav .nav-links .questions-nav__back {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0 0.75rem;
    color: #4b5563;
    font-size: 0.8125rem;
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 10px;
  }

  .questions-nav .nav-links .questions-nav__back:hover {
    background: #ffffff;
    border-color: rgba(37, 99, 235, 0.35);
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.12);
    color: #4b5563;
  }

  .questions-nav .nav-links .questions-nav__back:active {
    transform: scale(0.96);
  }
}


.questions-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  margin-bottom: 1.5rem;
}

.questions-tab {
  flex: 1;
  min-height: 2.75rem;
  padding: 0.4rem 1rem;
  border: 1px solid #e2e8f0;
  border-radius: 9999px;
  background: #ffffff;
  color: #4b5563;
  font-size: 0.9375rem;
  font-weight: 600;
  cursor: pointer;
  transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
}

.questions-tab:hover {
  border-color: var(--page-accent);
  color: var(--page-accent);
}

.questions-tab--placeholder,
.questions-tab--placeholder:hover {
  border-style: dashed;
  border-color: #e2e8f0;
  color: #9ca3af;
  cursor: not-allowed;
}

.questions-tab.is-active {
  background: var(--page-accent);
  border-color: var(--page-accent);
  color: #ffffff;
}

.questions-tab:focus-visible {
  outline: 2px solid var(--page-accent);
  outline-offset: 2px;
}

.questions-view {
  display: none;
}

.questions-view.is-active {
  display: block;
}

/* 正文排版 */
.questions-prose {
  line-height: 1.75;
  color: #374151;
  font-size: 0.9375rem;
}

.questions-prose h2 {
  margin: 2rem 0 0.75rem;
  font-size: 1.25rem;
  color: #14213d;
  padding-bottom: 0.4rem;
  border-bottom: 2px solid #e2e8f0;
}

.questions-prose h2:first-child {
  margin-top: 0;
}

.questions-prose h3 {
  margin: 1.5rem 0 0.5rem;
  font-size: 1.0625rem;
  color: #1f2937;
}

.questions-prose p {
  margin: 0.6rem 0;
}

.questions-prose blockquote {
  margin: 0.75rem 0;
  padding: 0.6rem 1rem;
  border-left: 3px solid var(--page-accent);
  background: #f8fafc;
  color: #4b5563;
  border-radius: 0 6px 6px 0;
}

.questions-prose ol,
.questions-prose ul {
  margin: 0.6rem 0;
  padding-left: 1.5rem;
}

.questions-prose li {
  margin: 0.3rem 0;
}

/* 代码块：横向滚动，防溢出 */
.questions-prose pre {
  margin: 0.75rem 0 1.25rem;
  padding: 0.9rem 1rem;
  border-radius: 8px;
  overflow-x: auto;
  font-size: 0.8125rem;
  line-height: 1.6;
  background: #0f172a;
}

.questions-prose code {
  font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
}

.questions-prose :not(pre) > code {
  padding: 0.1em 0.35em;
  border-radius: 4px;
  background: #f1f5f9;
  color: #be185d;
  font-size: 0.875em;
}

/* 正文图片：自适应容器宽度，保持比例 */
.questions-prose img {
  max-width: 100%;
  height: auto;
  border-radius: 8px;
  display: block;
  margin: 0.75rem auto;
}

/* Shiki 行内背景覆盖（pre 已统一深色背景） */
.questions-prose pre code {
  background: transparent;
}

@media (max-width: 700px) {
  .questions-tabs {
    flex-direction: column;
    gap: 0.5rem;
  }

  .questions-tab {
    flex: none;
    width: 100%;
    min-width: 0;
    white-space: nowrap;
    font-size: 0.875rem;
  }

  .questions-prose {
    font-size: 0.875rem;
  }

  .questions-prose pre {
    font-size: 0.75rem;
    margin-left: -0.25rem;
    margin-right: -0.25rem;
    border-radius: 6px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .questions-tab {
    transition: none;
  }
}

@media print {
  .questions-tabs {
    display: none;
  }

  .questions-view {
    display: block;
  }
}
  </style>
  <div class="card card-section questions-panel">
    <div class="questions-tabs" role="tablist" aria-label="题组切换">
      <button type="button" class="questions-tab is-active" id="questions-tab-c" role="tab" aria-selected="true" aria-controls="questions-c" data-questions="c">计算机部 · C 语言题组</button>
      <button type="button" class="questions-tab" id="questions-tab-python" role="tab" aria-selected="false" aria-controls="questions-python" data-questions="python" tabindex="-1">计算机部 · Python 题组</button>
      <button type="button" class="questions-tab" id="questions-tab-qrs" role="tab" aria-selected="false" aria-controls="questions-qrs" data-questions="qrs" tabindex="-1">嵌入式部 · 面试题组</button>
      <button type="button" class="questions-tab questions-tab--placeholder" disabled title="题组整理中，敬请期待">机械部 · 敬请期待</button>
    </div>
    <div class="questions-views">
      <div class="questions-view is-active questions-prose" id="questions-c" role="tabpanel" aria-labelledby="questions-tab-c">
        <CContent />
      </div>
      <div class="questions-view questions-prose" id="questions-python" role="tabpanel" aria-labelledby="questions-tab-python">
        <PythonContent />
      </div>
      <div class="questions-view questions-prose" id="questions-qrs" role="tabpanel" aria-labelledby="questions-tab-qrs">
        <QrsContent />
      </div>
    </div>
  </div>

  <script is:inline src="/html/recruitment-questions.js?v=20260904"></script>
</SubpageLayout>
