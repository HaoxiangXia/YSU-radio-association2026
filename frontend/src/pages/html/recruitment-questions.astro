---
import SubpageLayout from '../../layouts/SubpageLayout.astro';
import { getEntry, render } from 'astro:content';

const pythonEntry = await getEntry('questions', 'python');
const cEntry = await getEntry('questions', 'c');
if (!pythonEntry || !cEntry) throw new Error('题组内容缺失');
const { Content: PythonContent } = await render(pythonEntry);
const { Content: CContent } = await render(cEntry);
---
<SubpageLayout
  title="计算机部招新题组 - 无线电爱好者协会"
  bodyClass="site-page sub-page recruitment-questions-page"
  heroTitle="计算机部招新题组"
  heroDesc="Python 与 C 语言两套题组，供报名计算机部的同学参考准备。"
  mainClass="questions-content"
  heroCompact
>
  <style is:global>
/* 招新题组页：tab 切换复用管理员页 chart-tab 模式 */
.recruitment-questions-page {
  --page-accent: #2563eb;
}

.questions-tabs {
  display: flex;
  gap: 0.75rem;
  margin-bottom: 1.5rem;
}

.questions-tab {
  flex: 1;
  min-height: 2.75rem;
  padding: 0.4rem 1rem;
  border: 1px solid #e2e8f0;
  border-radius: 9999px;
  background: #ffffff;
  color: #4b5563;
  font-size: 0.9375rem;
  font-weight: 600;
  cursor: pointer;
  transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
}

.questions-tab:hover {
  border-color: var(--page-accent);
  color: var(--page-accent);
}

.questions-tab.is-active {
  background: var(--page-accent);
  border-color: var(--page-accent);
  color: #ffffff;
}

.questions-tab:focus-visible {
  outline: 2px solid var(--page-accent);
  outline-offset: 2px;
}

.questions-view {
  display: none;
}

.questions-view.is-active {
  display: block;
}

/* 正文排版 */
.questions-prose {
  line-height: 1.75;
  color: #374151;
  font-size: 0.9375rem;
}

.questions-prose h2 {
  margin: 2rem 0 0.75rem;
  font-size: 1.25rem;
  color: #14213d;
  padding-bottom: 0.4rem;
  border-bottom: 2px solid #e2e8f0;
}

.questions-prose h2:first-child {
  margin-top: 0;
}

.questions-prose h3 {
  margin: 1.5rem 0 0.5rem;
  font-size: 1.0625rem;
  color: #1f2937;
}

.questions-prose p {
  margin: 0.6rem 0;
}

.questions-prose blockquote {
  margin: 0.75rem 0;
  padding: 0.6rem 1rem;
  border-left: 3px solid var(--page-accent);
  background: #f8fafc;
  color: #4b5563;
  border-radius: 0 6px 6px 0;
}

.questions-prose ol,
.questions-prose ul {
  margin: 0.6rem 0;
  padding-left: 1.5rem;
}

.questions-prose li {
  margin: 0.3rem 0;
}

/* 代码块：横向滚动，防溢出 */
.questions-prose pre {
  margin: 0.75rem 0 1.25rem;
  padding: 0.9rem 1rem;
  border-radius: 8px;
  overflow-x: auto;
  font-size: 0.8125rem;
  line-height: 1.6;
  background: #0f172a;
}

.questions-prose code {
  font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
}

.questions-prose :not(pre) > code {
  padding: 0.1em 0.35em;
  border-radius: 4px;
  background: #f1f5f9;
  color: #be185d;
  font-size: 0.875em;
}

/* Shiki 行内背景覆盖（pre 已统一深色背景） */
.questions-prose pre code {
  background: transparent;
}

@media (max-width: 700px) {
  .questions-prose {
    font-size: 0.875rem;
  }

  .questions-prose pre {
    font-size: 0.75rem;
    margin-left: -0.25rem;
    margin-right: -0.25rem;
    border-radius: 6px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .questions-tab {
    transition: none;
  }
}

@media print {
  .questions-tabs {
    display: none;
  }

  .questions-view {
    display: block;
  }
}
  </style>

  <a href="/html/membership-application.html" class="back-link">← 返回入会申请</a>

  <div class="card card-section questions-panel">
    <div class="questions-tabs" role="tablist" aria-label="题组切换">
      <button type="button" class="questions-tab is-active" id="questions-tab-python" role="tab" aria-selected="true" aria-controls="questions-python" data-questions="python">Python 题组</button>
      <button type="button" class="questions-tab" id="questions-tab-c" role="tab" aria-selected="false" aria-controls="questions-c" data-questions="c" tabindex="-1">C 语言题组</button>
    </div>
    <div class="questions-views">
      <div class="questions-view is-active questions-prose" id="questions-python" role="tabpanel" aria-labelledby="questions-tab-python">
        <PythonContent />
      </div>
      <div class="questions-view questions-prose" id="questions-c" role="tabpanel" aria-labelledby="questions-tab-c">
        <CContent />
      </div>
    </div>
  </div>

  <script is:inline src="/html/recruitment-questions.js?v=20260904"></script>
</SubpageLayout>
