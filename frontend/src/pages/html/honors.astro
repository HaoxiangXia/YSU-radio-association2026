---
import { honorFeatureCards, leagueRanking, competitionTags, honorStats, honorCertificates } from '../../data/honors';

const certificateSizes = '(max-width: 639px) calc(100vw - 3rem), (max-width: 1023px) calc(50vw - 3rem), 21rem';
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>荣誉成就 - 无线电爱好者协会</title>
  <link rel="icon" href="/favicon.ico">
  <link rel="stylesheet" href="/html/styles.css?v=20260811">
  <style is:global>
/* 高亮行 */
.highlight-row {
  background: rgba(37, 99, 235, 0.05);
}

.highlight-row td {
  font-weight: 500;
}

.badge-red {
  background: rgba(239, 68, 68, 0.1);
  color: #dc2626;
}

.site-page .highlight-row {
  background: linear-gradient(90deg, rgba(219, 234, 254, 0.75), rgba(238, 242, 255, 0.5));
}

.site-page.honor-page {
  --page-accent: #b7791f;
  --page-accent-soft: rgba(217, 119, 6, 0.1);
}

/* 荣誉页：正式记录卡、榜单和统计分区 */
.site-page.honor-page .honor-feature-grid {
  align-items: stretch;
}

.site-page.honor-page .honor-feature-card {
  position: relative;
  display: flex;
  min-height: 15.5rem;
  overflow: hidden;
  flex-direction: column;
  border-color: rgba(59, 130, 246, 0.17);
  background: #ffffff;
}

.site-page.honor-page .honor-feature-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 1.35rem;
  width: 5.5rem;
  height: 3px;
  background: #2563eb;
}

.site-page.honor-page .honor-feature-card__topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}

.site-page.honor-page .honor-feature-card__topline {
  color: #4d75c4;
  font-size: 0.68rem;
  font-weight: 750;
  letter-spacing: 0.12em;
}

.site-page.honor-page .honor-feature-card h3 {
  margin: 2rem 0 0.75rem;
  color: var(--site-ink);
  font-size: clamp(1.12rem, 2.1vw, 1.42rem);
  line-height: 1.45;
}

.site-page.honor-page .honor-feature-card > p {
  color: var(--site-muted);
  font-size: 0.88rem;
  line-height: 1.7;
}

@media (max-width: 640px) {
  .site-page.honor-page .honor-feature-grid {
    gap: 1rem;
  }

  .site-page.honor-page .honor-feature-card {
    min-height: 0;
  }

  .site-page.honor-page .honor-feature-card::before {
    left: 1.25rem;
    width: 4.4rem;
  }

  .site-page.honor-page .honor-feature-card h3 {
    margin-top: 1.35rem;
    margin-bottom: 0.65rem;
    font-size: 1.18rem;
    line-height: 1.5;
  }

  .site-page.honor-page .honor-feature-card > p {
    font-size: 0.9rem;
    line-height: 1.68;
  }
}

.site-page.honor-page .honor-section {
  border-color: rgba(148, 163, 184, 0.18);
}

.site-page.honor-page .honor-section__heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 1.5rem;
  margin-bottom: 1.25rem;
}

.site-page.honor-page .honor-section__heading span {
  display: block;
  margin-bottom: 0.45rem;
  color: #4d75c4;
  font-size: 0.66rem;
  font-weight: 750;
  letter-spacing: 0.14em;
}

.site-page.honor-page .honor-section__heading .card-title {
  margin-bottom: 0;
  font-size: clamp(1.2rem, 2.4vw, 1.65rem);
}

.site-page.honor-page .honor-section__heading > p {
  color: var(--site-muted);
  font-size: 0.78rem;
}

.site-page.honor-page .honor-ranking .overflow-x-auto {
  box-shadow: none;
}

.site-page.honor-page .honor-ranking .highlight-row {
  box-shadow: inset 3px 0 #2563eb;
}

.site-page.honor-page .honor-competitions {
  background: #ffffff;
}

.site-page.honor-page .honor-competitions .tag {
  padding: 0.55rem 0.9rem;
  background: rgba(239, 246, 255, 0.82);
}

.site-page.honor-page .honor-stats-panel {
  background: #f8fbff;
}

.site-page.honor-page .honor-stats-grid .stat-card {
  border-color: rgba(255, 255, 255, 0.84);
  background: rgba(255, 255, 255, 0.76);
  box-shadow: 0 8px 22px rgba(30, 64, 175, 0.06);
}

.site-page.honor-page .honor-certificate-gallery {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1rem;
}

.site-page.honor-page .honor-certificate {
  display: block;
  width: 100%;
  overflow: hidden;
  padding: 0;
  color: inherit;
  border: 1px solid rgba(59, 130, 246, 0.14);
  border-radius: 1rem;
  background: #ffffff;
  box-shadow: 0 10px 26px rgba(15, 23, 42, 0.06);
  cursor: zoom-in;
  text-align: left;
  transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
}

.site-page.honor-page .honor-certificate:hover {
  transform: translateY(-3px);
  border-color: rgba(37, 99, 235, 0.32);
  box-shadow: 0 16px 32px rgba(30, 64, 175, 0.12);
}

.site-page.honor-page .honor-certificate:focus-visible {
  outline: 3px solid #60a5fa;
  outline-offset: 3px;
}

.site-page.honor-page .honor-certificate__image {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0.45rem;
  background: #f8fafc;
}

.site-page.honor-page .honor-certificate img {
  display: block;
  width: 100%;
  height: auto;
  border-radius: 0.6rem;
}

.site-page.honor-page .honor-certificate__meta {
  display: grid;
  gap: 0.3rem;
  padding: 0.9rem 1rem 1rem;
}

.site-page.honor-page .honor-certificate__meta span {
  color: #4d75c4;
  font-size: 0.72rem;
  font-weight: 750;
  letter-spacing: 0.08em;
}

.site-page.honor-page .honor-certificate__meta strong {
  color: var(--site-ink);
  font-size: 0.94rem;
  line-height: 1.55;
}

@media (min-width: 640px) {
  .site-page.honor-page .honor-certificate-gallery {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (min-width: 1024px) {
  .site-page.honor-page .honor-certificate-gallery {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

.col-rank {
  width: 3rem;
}
  </style>
</head>
<body class="site-page sub-page honor-page">
  <div id="nav-placeholder"></div>

  <header class="subpage-hero">
    <div class="container subpage-hero__inner">
      <h1>荣誉成就</h1>
      <p>汇总协会在竞赛、实践和校园组织建设中的阶段性成果。</p>
    </div>
  </header>

  <main class="page-container subpage-content honor-content">
    <!-- 荣誉卡片 -->
    <div id="honors-cards" class="grid md:grid-cols-3 gap-4 mb-6 honor-feature-grid">
      {honorFeatureCards.map((card) => (
        <article class="card card-section honor-feature-card reveal">
          <div class="honor-feature-card__topline">
            <span>{card.year}</span>
            {card.badge && <span class="badge badge-red">{card.badge}</span>}
          </div>
          <h3>{card.title}</h3>
          <p>{card.desc}</p>
        </article>
      ))}
    </div>

    <!-- 活力团支部榜单 -->
    <section class="card card-section mb-6 honor-section honor-ranking">
      <div class="honor-section__heading">
        <div>
          <span>2022</span>
          <h2 class="card-title">河北省高校活力团支部TOP10</h2>
        </div>
        <p>省内高校团支部活力建设榜单</p>
      </div>
      <p class="table-scroll-hint" aria-hidden="true">左右滑动查看更多</p>
      <div class="overflow-x-auto">
        <table class="data-table">
          <thead>
            <tr>
              <th class="text-center col-rank">排名</th>
              <th>学校</th>
              <th>团支部名称</th>
            </tr>
          </thead>
          <tbody id="league-table">
            {leagueRanking.map((row) => (
              <tr class={row.highlight ? 'highlight-row' : ''}>
                <td class:list={['text-center', 'font-bold', row.rank <= 3 ? 'text-blue-600' : 'text-gray-600']}>{row.rank}</td>
                <td class="text-gray-600">{row.school}</td>
                <td class="text-gray-600">{row.branch}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- 竞赛列表 -->
    <section class="card card-section mb-6 honor-section honor-competitions">
      <div class="honor-section__heading">
        <div>
          <h2 class="card-title">参与竞赛</h2>
        </div>
      </div>
      <div class="flex flex-wrap gap-2" id="competition-tags">
        {competitionTags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    </section>

    <!-- 成就统计 -->
    <section class="card card-section honor-section honor-stats-panel">
      <div class="honor-section__heading">
        <div>
          <span>2024–2026</span>
          <h2 class="card-title">近三年竞赛成果</h2>
        </div>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 honor-stats-grid">
        {honorStats.map((stat) => (
          <div class="stat-card">
            <div class="stat-value">{stat.value}</div>
            <div class="stat-label">{stat.label}</div>
          </div>
        ))}
      </div>
    </section>

    <section class="card card-section honor-section honor-certificate-section">
      <div class="honor-section__heading">
        <div>
          <span>2024–2026</span>
          <h2 class="card-title">近三年代表性获奖证书</h2>
        </div>
      </div>
      <div class="honor-certificate-gallery">
        {honorCertificates.map((cert) => (
          <button
            class="honor-certificate reveal"
            type="button"
            data-image={cert.image}
            data-image-alt={cert.img.alt}
            aria-label={cert.ariaLabel}
          >
            <span class="honor-certificate__image">
              <img
                src={cert.img.src}
                srcset={cert.img.srcset}
                sizes={certificateSizes}
                width={cert.img.width}
                height={cert.img.height}
                alt={cert.img.alt}
                loading="lazy"
                decoding="async"
              >
            </span>
            <span class="honor-certificate__meta"><span>{cert.meta}</span><strong>{cert.title}</strong></span>
          </button>
        ))}
      </div>
    </section>
  </main>

  <div id="footer-placeholder"></div>

  <button class="scrollTopBtn" title="回到顶部">↑</button>

  <div class="image-viewer">
    <img src="" alt="查看图片">
  </div>

  <script is:inline src="/html/image-assets.js?v=20260729"></script>
  <script is:inline src="/html/common.js?v=20260729"></script>
  <script is:inline src="/html/reveal.js?v=20260812"></script>
</body>
</html>
