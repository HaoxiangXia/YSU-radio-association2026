# Normalize detected text files and keep working-tree line endings consistent.
* text=auto eol=lf

# Preserve CRLF for Windows batch scripts.
*.bat text eol=crlf
*.cmd text eol=crlf

# Store video assets with Git LFS and never apply text conversion.
*.mp4 filter=lfs diff=lfs merge=lfs -text

# Keep original image sources in Git, but exclude them from production archives.
source-assets/** export-ignore
