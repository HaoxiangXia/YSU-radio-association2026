#!/usr/bin/env bash
set -Eeuo pipefail
umask 027

APP_ROOT="${RADIO_APP_ROOT:-/opt/radio-association}"
RELEASES_DIR="$APP_ROOT/releases"
CURRENT_LINK="$APP_ROOT/current"
PREVIOUS_LINK="$APP_ROOT/previous"
CONFIG_DIR="${RADIO_CONFIG_DIR:-/etc/radio-association}"
ENV_FILE="$CONFIG_DIR/app.env"
RECRUITMENT_CONFIG="$CONFIG_DIR/recruitment.json"
STATE_ROOT="${RADIO_STATE_ROOT:-/var/lib/radio-association}"
DATABASE_PATH="$STATE_ROOT/data/database.sqlite"
ADMISSIONS_PATH="$STATE_ROOT/private/admissions.json"
BACKUP_STATUS_PATH="$STATE_ROOT/state/backup-status.json"
BACKUP_ROOT="${RADIO_BACKUP_ROOT:-/var/backups/radio-association}"
BACKUP_TOOL="${RADIO_BACKUP_TOOL:-/usr/local/lib/radio-association/sqlite_backup.py}"
EXTRACT_TOOL="${RADIO_EXTRACT_TOOL:-/usr/local/lib/radio-association/extract_release.py}"
SERVICE="${RADIO_SERVICE:-radio-association.service}"
LOCK_FILE="${RADIO_LOCK_FILE:-/run/lock/radio-association.lock}"
HEALTH_URL="${RADIO_HEALTH_URL:-http://127.0.0.1:5000/healthz}"
APP_USER="${RADIO_APP_USER:-radio-association}"
export UV_PYTHON_INSTALL_DIR="${UV_PYTHON_INSTALL_DIR:-/opt/uv-python}"

log() {
    printf '[radioctl] %s\n' "$*"
}

fail() {
    printf '[radioctl] 错误：%s\n' "$*" >&2
    exit 1
}

require_root() {
    [[ "${EUID:-$(id -u)}" -eq 0 ]] || fail "该操作必须由 root 或 sudo 执行"
}

acquire_lock() {
    mkdir -p "$(dirname "$LOCK_FILE")"
    exec 9>"$LOCK_FILE"
    flock -n 9 || fail "另一项部署、备份或配置操作正在执行"
}

require_sha() {
    [[ "$1" =~ ^[0-9a-f]{40}$ ]] || fail "commit SHA 必须是 40 位小写十六进制"
}

require_runtime_config() {
    [[ -f "$ENV_FILE" ]] || fail "缺少 $ENV_FILE"
    [[ -f "$RECRUITMENT_CONFIG" ]] || fail "缺少 $RECRUITMENT_CONFIG"
    ! grep -q '请替换' "$ENV_FILE" ||
        fail "$ENV_FILE 仍包含示例占位值"
    grep -qE '^JWT_SECRET=.{32,}$' "$ENV_FILE" ||
        fail "$ENV_FILE 缺少长度至少为 32 的 JWT_SECRET"
    grep -qE '^RECRUITMENT_OFFICER_ACCOUNTS=.+' "$ENV_FILE" ||
        fail "$ENV_FILE 缺少 RECRUITMENT_OFFICER_ACCOUNTS"
}

wait_for_health() {
    local attempts="${1:-20}"
    local index
    for ((index = 1; index <= attempts; index += 1)); do
        if curl --fail --silent --show-error --max-time 3 "$HEALTH_URL" >/dev/null; then
            return 0
        fi
        sleep 1
    done
    return 1
}

atomic_symlink() {
    local target="$1"
    local link="$2"
    local temporary="${link}.new.$$"
    ln -s "$target" "$temporary"
    mv -Tf "$temporary" "$link"
}

validate_release_config() {
    local release="$1"
    RECRUITMENT_CONFIG_PATH="$RECRUITMENT_CONFIG" \
        PYTHONPATH="$release/backend" \
        "$release/backend/.venv/bin/python" -c \
        'from config.recruitment import load_recruitment_config; load_recruitment_config()'
}

validate_admissions() {
    local candidate="$1"
    local release
    release="$(readlink -f "$CURRENT_LINK")"
    PYTHONPATH="$release/backend" \
        "$release/backend/.venv/bin/python" -c \
        'import sys; from routes.admissions import load_admissions; records = load_admissions(sys.argv[1]); print(f"已校验 {len(records)} 条录取结果")' \
        "$candidate"
}

backup_database() {
    local reason="${1:-manual}"
    local timestamp destination checksum oss_uri=""
    if [[ ! -f "$DATABASE_PATH" ]]; then
        log "数据库尚不存在，跳过备份"
        return 0
    fi

    timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
    destination="$BACKUP_ROOT/database-${timestamp}-${reason}.sqlite"
    mkdir -p "$BACKUP_ROOT"
    checksum="$(python3 "$BACKUP_TOOL" backup "$DATABASE_PATH" "$destination")"

    if [[ -n "${OSS_BACKUP_URI:-}" ]]; then
        command -v ossutil >/dev/null || fail "已配置 OSS_BACKUP_URI，但未找到 ossutil"
        oss_uri="${OSS_BACKUP_URI%/}/$(basename "$destination")"
        ossutil cp -f "$destination" "$oss_uri"
        ossutil cp -f "${destination}.sha256" "${oss_uri}.sha256"
        ossutil stat "$oss_uri" >/dev/null
    fi

    python3 "$BACKUP_TOOL" status \
        "$BACKUP_STATUS_PATH" "$destination" "$checksum" --oss-uri "$oss_uri"
    chown root:"$APP_USER" "$BACKUP_STATUS_PATH"
    chmod 640 "$BACKUP_STATUS_PATH"
    find "$BACKUP_ROOT" -maxdepth 1 -type f \
        \( -name 'database-*.sqlite' -o -name 'database-*.sqlite.sha256' \) \
        -mtime +14 -delete
    log "备份完成：$destination"
}

command_deploy() {
    [[ $# -eq 3 ]] || fail "用法：radioctl deploy <archive.tar.gz> <commit-sha> <sha256>"
    local archive="$1" commit="$2" expected_checksum="$3"
    local release="$RELEASES_DIR/$commit"
    local staging="$RELEASES_DIR/.${commit}.staging.$$"
    local actual_checksum previous_target=""

    require_sha "$commit"
    [[ "$expected_checksum" =~ ^[0-9a-f]{64}$ ]] || fail "归档 SHA-256 格式无效"
    [[ -f "$archive" ]] || fail "发布归档不存在：$archive"
    require_runtime_config

    actual_checksum="$(sha256sum "$archive" | awk '{print $1}')"
    [[ "$actual_checksum" == "$expected_checksum" ]] || fail "发布归档 SHA-256 不匹配"
    [[ ! -e "$release" ]] || fail "发布目录已存在：$release"

    mkdir -p "$RELEASES_DIR"
    [[ ! -e "$staging" ]] || fail "临时发布目录已存在：$staging"
    mkdir "$staging"
    python3 "$EXTRACT_TOOL" "$archive" "$staging"
    [[ -f "$staging/backend/pyproject.toml" ]] || fail "归档缺少 backend/pyproject.toml"
    [[ -f "$staging/backend/uv.lock" ]] || fail "归档缺少 backend/uv.lock"
    printf '%s\n' "$commit" >"$staging/RELEASE_COMMIT"
    printf '%s\n' "$actual_checksum" >"$staging/RELEASE_ARCHIVE_SHA256"
    mv "$staging" "$release"

    (
        cd "$release/backend"
        uv sync --frozen --no-dev --python 3.11
    )
    validate_release_config "$release"
    chown -R root:"$APP_USER" "$release"
    chmod -R g-w,o-w "$release"

    backup_database "predeploy"
    if [[ -L "$CURRENT_LINK" ]]; then
        previous_target="$(readlink -f "$CURRENT_LINK")"
    fi
    atomic_symlink "$release" "$CURRENT_LINK"
    systemctl daemon-reload

    if ! systemctl restart "$SERVICE" || ! wait_for_health; then
        log "新版本健康检查失败，正在恢复先前版本"
        if [[ -n "$previous_target" ]]; then
            atomic_symlink "$previous_target" "$CURRENT_LINK"
            systemctl restart "$SERVICE" || true
        else
            systemctl stop "$SERVICE" || true
            rm -f "$CURRENT_LINK"
        fi
        journalctl -u "$SERVICE" -n 50 --no-pager >&2 || true
        fail "部署失败，代码链接已自动回滚"
    fi

    if [[ -n "$previous_target" ]]; then
        atomic_symlink "$previous_target" "$PREVIOUS_LINK"
    fi
    log "已部署 commit $commit"
}

command_rollback() {
    [[ $# -le 1 ]] || fail "用法：radioctl rollback [commit-sha]"
    local target current
    current="$(readlink -f "$CURRENT_LINK")"
    if [[ $# -eq 1 ]]; then
        require_sha "$1"
        target="$RELEASES_DIR/$1"
    else
        [[ -L "$PREVIOUS_LINK" ]] || fail "没有可用的 previous 发布"
        target="$(readlink -f "$PREVIOUS_LINK")"
    fi
    [[ -d "$target" ]] || fail "回滚目标不存在：$target"
    [[ "$target" != "$current" ]] || fail "回滚目标已经是当前版本"

    backup_database "prerollback"
    atomic_symlink "$target" "$CURRENT_LINK"
    if ! systemctl restart "$SERVICE" || ! wait_for_health; then
        atomic_symlink "$current" "$CURRENT_LINK"
        systemctl restart "$SERVICE" || true
        fail "回滚目标健康检查失败，已恢复原版本"
    fi
    atomic_symlink "$current" "$PREVIOUS_LINK"
    log "已回滚到 $(basename "$target")"
}

command_restore() {
    [[ $# -eq 2 && "$2" == "--confirm" ]] ||
        fail "用法：radioctl restore <backup.sqlite> --confirm"
    local source="$1"
    [[ -f "$source" ]] || fail "恢复源不存在：$source"
    [[ -f "${source}.sha256" ]] || fail "恢复源缺少 .sha256 校验文件"

    systemctl stop "$SERVICE"
    if ! python3 "$BACKUP_TOOL" restore \
        "$source" "$DATABASE_PATH" "$BACKUP_ROOT"; then
        systemctl start "$SERVICE" || true
        fail "恢复失败，原数据库未被无校验覆盖"
    fi
    chown "$APP_USER":"$APP_USER" "$DATABASE_PATH"
    chmod 640 "$DATABASE_PATH"
    systemctl start "$SERVICE"
    wait_for_health || fail "恢复后应用健康检查失败，请检查服务日志"
    backup_database "postrestore"
    log "数据库恢复完成"
}

install_private_file() {
    local source="$1" target="$2" mode="$3"
    local directory backup=""
    directory="$(dirname "$target")"
    mkdir -p "$directory"
    if [[ -f "$target" ]]; then
        backup="${target}.previous.$(date -u +%Y%m%dT%H%M%SZ)"
        install -o root -g "$APP_USER" -m "$mode" "$target" "$backup"
    fi
    install -o root -g "$APP_USER" -m "$mode" "$source" "${target}.new.$$"
    mv -f "${target}.new.$$" "$target"
    printf '%s' "$backup"
}

command_configure() {
    [[ $# -eq 1 ]] || fail "用法：radioctl configure <recruitment.json>"
    local source="$1" release backup=""
    [[ -f "$source" ]] || fail "配置文件不存在：$source"
    release="$(readlink -f "$CURRENT_LINK")"
    RECRUITMENT_CONFIG_PATH="$source" PYTHONPATH="$release/backend" \
        "$release/backend/.venv/bin/python" -c \
        'from config.recruitment import load_recruitment_config; load_recruitment_config()'
    backup="$(install_private_file "$source" "$RECRUITMENT_CONFIG" 640)"
    if ! systemctl restart "$SERVICE" || ! wait_for_health; then
        if [[ -n "$backup" ]]; then
            install -o root -g "$APP_USER" -m 640 "$backup" "$RECRUITMENT_CONFIG"
        else
            rm -f "$RECRUITMENT_CONFIG"
        fi
        systemctl restart "$SERVICE" || true
        fail "新招新配置未通过运行时健康检查，已恢复上一份配置"
    fi
    log "招新配置已安全更新"
}

command_admissions() {
    [[ $# -eq 1 ]] || fail "用法：radioctl admissions <admissions.json>"
    local source="$1" backup=""
    [[ -f "$source" ]] || fail "录取名单不存在：$source"
    validate_admissions "$source"
    backup="$(install_private_file "$source" "$ADMISSIONS_PATH" 640)"
    if ! systemctl restart "$SERVICE" || ! wait_for_health; then
        if [[ -n "$backup" ]]; then
            install -o root -g "$APP_USER" -m 640 "$backup" "$ADMISSIONS_PATH"
        else
            rm -f "$ADMISSIONS_PATH"
        fi
        systemctl restart "$SERVICE" || true
        fail "新录取名单未通过运行时健康检查，已恢复上一份名单"
    fi
    find "$(dirname "$ADMISSIONS_PATH")" -maxdepth 1 -type f \
        -name 'admissions.json.previous.*' -mtime +14 -delete
    log "录取名单已安全更新"
}

command_status() {
    printf 'current=%s\n' "$(readlink -f "$CURRENT_LINK" 2>/dev/null || true)"
    printf 'previous=%s\n' "$(readlink -f "$PREVIOUS_LINK" 2>/dev/null || true)"
    systemctl status "$SERVICE" --no-pager || true
    printf '\n监听端口：\n'
    ss -ltnp | grep -E ':(5000|8080|80|443)\b' || true
    printf '\n健康检查：\n'
    curl --silent --show-error "$HEALTH_URL" || true
    printf '\n备份状态：\n'
    curl --silent --show-error "http://127.0.0.1:5000/ops/backupz" || true
    printf '\n'
}

usage() {
    cat <<'EOF'
用法：
  radioctl deploy <archive.tar.gz> <commit-sha> <sha256>
  radioctl rollback [commit-sha]
  radioctl backup
  radioctl restore <backup.sqlite> --confirm
  radioctl configure <recruitment.json>
  radioctl admissions <admissions.json>
  radioctl status
EOF
}

command="${1:-}"
[[ -n "$command" ]] || {
    usage
    exit 2
}
shift

case "$command" in
    status)
        command_status "$@"
        ;;
    deploy|rollback|backup|restore|configure|admissions)
        require_root
        acquire_lock
        case "$command" in
            deploy) command_deploy "$@" ;;
            rollback) command_rollback "$@" ;;
            backup) [[ $# -eq 0 ]] || fail "用法：radioctl backup"; backup_database "scheduled" ;;
            restore) command_restore "$@" ;;
            configure) command_configure "$@" ;;
            admissions) command_admissions "$@" ;;
        esac
        ;;
    *)
        usage
        exit 2
        ;;
esac
