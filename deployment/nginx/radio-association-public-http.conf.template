server {
    listen 80;
    server_name __DOMAIN__;
    server_tokens off;

    access_log /var/log/nginx/radio-association.access.log radio_minimal;
    error_log /var/log/nginx/radio-association.error.log warn;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        default_type text/plain;
        add_header Retry-After 300 always;
        return 503 "HTTPS setup in progress. Please try again later.\n";
    }
}
