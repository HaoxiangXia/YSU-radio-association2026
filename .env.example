# 本地开发与部署都从本文件复制为 .env 后填写；.env 不提交到 Git。
PORT=5000

# SQLite 数据库路径。相对路径基于仓库根目录解析；缺省为 backend/data/database.sqlite。
# DATABASE_PATH=backend/data/database.sqlite

# JWT 签名密钥。必须设置为足够长的随机字符串，未设置时应用启动失败。
JWT_SECRET=replace-with-a-long-random-secret

# 招新负责人账号（仅一个）。密码必须是 PBKDF2 哈希，
# 生成命令：cd backend && uv run python ../scripts/hash-password.py
# 两个变量都未设置时应用启动失败。哈希包含 $ 等字符，建议用双引号包裹。
OFFICER_USERNAME=admin
OFFICER_PASSWORD_HASH="pbkdf2_sha256$100000$..."
